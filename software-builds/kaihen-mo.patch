index 0000000..3747804
--- /dev/null
+++ b/hen/tests/reload_test.cpp
@@ -0,0 +1,302 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <thread>
+#include <mutex>
+#include <condition_variable>
