+        const Handle child = service(Kind::Fs, realm);
+        ounce::sm::writeReply(tls.data(), ounce::sm::Protocol::Cmif, child ? 0 : MAKERESULT(345, 240), child); return 0;
+    }
+    assert(object->kind == Kind::Master && header->command_id == 1);
