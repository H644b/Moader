+    u32 flags;
+    u64 operation_id;
+    u32 stage;
+    u32 primary_gate_step;
+    u32 restoration_gate_step;
+    u32 matching_mounts;
+    Result primary_result;
+    Result restoration_result;
+    Result pm_result;
+    Result probe_result;
+    u32 probe_state;
+    u32 probe_wait_kind;
+    u32 probe_selected_mask;
+    u32 probe_receive_result;
