+    Handle fs = INVALID_HANDLE, sm = INVALID_HANDLE;
+    Result rc = cmifCloneCurrentObject(fs_root_, &fs);
+    if (R_SUCCEEDED(rc)) rc = sm_proxy_.openSession(&sm);
+    if (R_SUCCEEDED(rc)) rc = reload_journal_.begin(caller_pid, request, &entry);
+    if (R_FAILED(rc)) {
