diff --git a/tools/moader-local.cjs b/tools/moader-local.cjs
new file mode 100644
index 0000000..5499ece
--- /dev/null
+++ b/tools/moader-local.cjs
@@ -0,0 +1,191 @@
+// Local Moader route for the Seedsow GUI. The public kaiHEN archive supplies
+// the unchanged release files; the patched Moader RO, HEN and bootstrap are
+// admitted only as the exact matched build set from the backend kit.
+'use strict';
+const fs = require('node:fs');
+const path = require('node:path');
+const crypto = require('node:crypto');
+const {spawnSync} = require('node:child_process');
+const {download, extract} = require('./zip.cjs');
+const {findReleaseRoot} = require('./kaihen-release.cjs');
+
+const ROOT = path.resolve(__dirname, '..');
+const MOADER = process.env.MOADER_ROOT ? path.resolve(process.env.MOADER_ROOT) : null;
+const NODE24 = process.env.MOADER_NODE24 || process.execPath;
+const BASE_URL = 'https://github.com/ouncebrew/kaihen/releases/download/20261114c/kaiHEN-20261114c.zip';
+const BASE_SHA256 = '63b91e5e7c6f411aad758758e5a1a3cbe1f855b4304d87916afe5319b9dfd967';
+const FULL_BUNDLE = 'bundles/kaiHEN-Moader-20261114c.zip';
+const REVISION = '7d0d8b370a0ae9cf7fb70b4f8d532886d0ec4a17';
+const sha = bytes => crypto.createHash('sha256').update(bytes).digest('hex');
+const check = (ok, message) => { if (!ok) throw Error(message); };
+
+function local() {
+  check(MOADER && fs.realpathSync(MOADER) === MOADER && fs.statSync(MOADER).isDirectory(),
+    'Set MOADER_ROOT to the canonical Moader checkout before using this GUI');
+  const node = spawnSync(NODE24, ['-v'], {encoding: 'utf8', timeout: 5000});
+  check(!node.error && node.status === 0 && /^v24\./.test(node.stdout.trim()),
+    'Moader installation requires POSIX Node.js 24 at ' + NODE24);
+  const profile = JSON.parse(fs.readFileSync(path.join(MOADER, 'config/seedsow-provider.json')));
+  check(profile.id === 'seedsow-malev0' && profile.revision === REVISION &&
+    profile.sourceTreeSha256 === '4d4375f2729ca4b95a98348419c1e2b7edffa684bf53316f00a38194c5f4ca7b',
+  'Moader is not pinned to this GUI source revision');
+  return {root: MOADER, node: NODE24, profile};
+}
+
+function verifyBundle(manifest) {
+  const folder = path.join(ROOT, 'kaihen');
+  const markerFile = path.join(folder, 'moader-local.json');
+  check(fs.statSync(markerFile, {throwIfNoEntry: false})?.isFile(),
+    'Use Auto-Download Moader kaiHEN before starting the installation');
+  const marker = JSON.parse(fs.readFileSync(markerFile, 'utf8'));
+  const components = Object.fromEntries(manifest.kaihenFiles.map(item =>
+    [path.relative(manifest.kaihen, item.source).split(path.sep).join('/'), item]));
+  check(marker.schema === 1 && marker.source === 'local matched Moader build' &&
+    marker.seedsowRevision === REVISION && marker.baseSha256 === BASE_SHA256 &&
+    marker.roSha256 === components['ro/main']?.sha256 &&
+    marker.henSha256 === components['hen/main']?.sha256 &&
+    marker.bootstrapSha256 === components['bootstrap.bin']?.sha256,
+  'GUI Moader kaiHEN marker differs from the prepared matched pair');
+  for (const relative of ['ro/main', 'hen/main', 'game/main', 'bootstrap.bin', 'hbmenu.nro']) {
+    check(components[relative], 'Prepared kaiHEN component is missing: ' + relative);
+    validatedFile(path.join(folder, relative), components[relative]);
+  }
+  for (const [target, relative] of [['/switch/Moader.nro', 'programs/Moader.nro'],
+    ['/kaihen/plugins/moader.nso', 'plugins/moader.nso']]) {
+    const item = manifest.programs.find(row => row.target === target);
+    check(item, 'Prepared Moader program is missing: ' + target);
+    validatedFile(path.join(folder, relative), item);
+  }
+  const shell = manifest.bundledPrograms?.find(row => row.target === '/switch/ounceshell.nro');
+  check(shell, 'Complete regular kaiHEN OunceShell is missing from the prepared snapshot');
+  validatedFile(path.join(folder, 'programs/ounceshell.nro'), shell);
+  return marker;
+}
+
+function filesBelow(root, dir = root) {
+  return fs.readdirSync(dir, {withFileTypes: true}).flatMap(entry => {
+    const file = path.join(dir, entry.name);
+    check(!entry.isSymbolicLink() && (entry.isDirectory() || entry.isFile()),
+      'Unexpected kaiHEN release member: ' + file);
+    return entry.isDirectory() ? filesBelow(root, file) :
+      [path.relative(root, file).split(path.sep).join('/')];
+  }).sort();
+}
+
+async function prepare({requireBundle = false} = {}) {
+  const selected = local();
+  const manifest = await require(path.join(MOADER, 'tools/install-moader.cjs'))
+    .prepare('seedsow-malev0');
+  check(manifest.hostProfile?.revision === REVISION,
+    'Prepared Moader snapshot has a different Seedsow revision');
+  if (requireBundle) verifyBundle(manifest);
+  return {selected, manifest};
+}
+
+function validatedFile(file, expected) {
+  check(fs.realpathSync(file) === file && fs.lstatSync(file).isFile(),
+    'Moader candidate is not a regular file: ' + file);
+  const bytes = fs.readFileSync(file);
+  check(bytes.length === expected.bytes && sha(bytes) === expected.sha256,
+    'Moader candidate differs from its matched build proof: ' + file);
+  return bytes;
+}
+
+async function updateFromMatchedBuild() {
+  const {manifest} = await prepare();
+  const build = await require(path.join(MOADER, 'tools/install-inputs.cjs'))
+    .qualifyKaihenBuild(MOADER);
+  check(build.schema === 3 && build.protocolVersion === 7,
+    'Moader matched kaiHEN build proof differs');
+  const target = path.join(ROOT, 'kaihen');
+  const runs = path.join(ROOT, 'runs');
+  fs.mkdirSync(runs, {recursive: true});
+  check(fs.realpathSync(runs) === runs && fs.lstatSync(runs).isDirectory(),
+    'Seedsow GUI runs path must be a canonical directory');
+  const staging = fs.mkdtempSync(path.join(runs, 'moader-kaihen-update-'));
+  let backup = null;
+  try {
+    const unpacked = path.join(staging, 'unpacked');
+    const included = path.join(MOADER, FULL_BUNDLE);
+    const hasIncluded = fs.existsSync(included);
+    if (hasIncluded) {
+      check(fs.realpathSync(included) === included && fs.lstatSync(included).isFile(),
+        'Included full Moader kaiHEN bundle is not a regular file');
+      const official = path.join(MOADER, 'research/artifacts/kaiHEN-20261114c.zip');
+      check(fs.realpathSync(official) === official &&
+        sha(fs.readFileSync(official)) === BASE_SHA256,
+      'Pinned official kaiHEN base for the included bundle differs');
+      const original = path.join(staging, 'official');
+      extract(official, original);
+      extract(included, unpacked);
+      const prior = findReleaseRoot(original), candidate = findReleaseRoot(unpacked);
+      const expected = filesBelow(prior), actual = filesBelow(candidate);
+      check(JSON.stringify(actual) === JSON.stringify([...expected,
+        'plugins/moader.nso', 'programs/Moader.nro'].sort()),
+      'Included Moader kaiHEN is not the complete official file set plus Moader');
+      for (const relative of expected.filter(name =>
+        !['ro/main', 'hen/main', 'bootstrap.bin'].includes(name)))
+        check(fs.readFileSync(path.join(prior, relative)).equals(
+          fs.readFileSync(path.join(candidate, relative))),
+        'Included kaiHEN changed an unpatched official release file: ' + relative);
+    } else {
+      const zip = path.join(staging, 'kaiHEN-20261114c.zip');
+      const received = await download(BASE_URL, zip);
+      check(received.sha256 === BASE_SHA256,
+        'Pinned official kaiHEN release checksum differs');
+      extract(zip, unpacked);
+    }
+    const base = findReleaseRoot(unpacked);
+    const next = path.join(staging, 'next');
+    fs.cpSync(base, next, {recursive: true, force: false});
+    for (const relative of ['ro/main', 'hen/main', 'bootstrap.bin']) {
+      const input = path.join(manifest.kaihen, relative);
+      const bytes = validatedFile(input, build.components[relative]);
+      const output = path.join(next, relative);
+      fs.mkdirSync(path.dirname(output), {recursive: true});
+      fs.writeFileSync(output, bytes);
+    }
+    const programs = [
+      {target: 'programs/Moader.nro', name: '/switch/Moader.nro'},
+      {target: 'plugins/moader.nso', name: '/kaihen/plugins/moader.nso'},
+    ];
+    for (const program of programs) {
+      const item = manifest.programs.find(row => row.target === program.name);
+      check(item, 'Prepared Moader program is missing: ' + program.name);
+      const bytes = validatedFile(item.source, item);
+      const output = path.join(next, program.target);
+      fs.mkdirSync(path.dirname(output), {recursive: true});
+      fs.writeFileSync(output, bytes);
+    }
+    const marker = {schema: 1, source: 'local matched Moader build',
+      seedsowRevision: REVISION, baseSha256: BASE_SHA256,
+      roSha256: build.components['ro/main'].sha256,
+      henSha256: build.components['hen/main'].sha256,
+      bootstrapSha256: build.components['bootstrap.bin'].sha256,
+      preparedManifest: manifest.manifestFile};
+    fs.writeFileSync(path.join(next, 'moader-local.json'), JSON.stringify(marker, null, 2) + '\n');
+    for (const relative of ['ro/main', 'hen/main', 'bootstrap.bin'])
+      validatedFile(path.join(next, relative), build.components[relative]);
+    const shell = manifest.bundledPrograms?.find(row => row.target === '/switch/ounceshell.nro');
+    check(shell, 'Complete regular kaiHEN OunceShell is missing from the prepared snapshot');
+    validatedFile(path.join(next, 'programs/ounceshell.nro'), shell);
+    if (fs.existsSync(target)) {
+      backup = path.join(runs, 'kaihen-backup-' + Date.now() + '-' +
+        crypto.randomBytes(3).toString('hex'));
+      fs.renameSync(target, backup);
+    }
+    try { fs.renameSync(next, target); }
+    catch (error) { if (backup) fs.renameSync(backup, target); throw error; }
+    return {tag: '20261114c + local Moader build', target,
+      downloaded: hasIncluded ? null : BASE_URL, includedFullBundle: hasIncluded,
+      roSha256: marker.roSha256,
+      henSha256: marker.henSha256,
+      bootstrapSha256: marker.bootstrapSha256, backup,
+      count: filesBelow(target).length, matched: true};
+  } finally {
+    fs.rmSync(staging, {recursive: true, force: true});
+  }
+}
+
+module.exports = {local, prepare, verifyBundle, updateFromMatchedBuild, MOADER, NODE24,
+  BASE_URL, BASE_SHA256, REVISION};
